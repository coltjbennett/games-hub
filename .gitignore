# ============================================================
# Games Hub — Git ignore rules
# Keep source files, games, applets, public assets, and the
# GitHub Pages workflow tracked. Ignore only local/generated data.
# ============================================================

# macOS Finder metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows Explorer metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux desktop / file-manager metadata
.directory
.Trash-*/

# Editors and IDEs (keep shared project configuration if desired)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# Local environment variables and credentials — never commit secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx

# Logs and crash reports
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Test / coverage output (if tooling is added later)
coverage/
.nyc_output/
playwright-report/
test-results/

# Generated build output (only ignore these if they are generated;
# your current GitHub Pages workflow deploys the repository root)
/dist/
/build/
/out/

# Temporary archives, exports, and scratch files created locally
*.tmp
*.temp
*.bak
*.old
*.zip
*.tar
*.tar.gz
*.7z

# Local operating-system / development scratch directories
.tmp/
.temp/
.cache/

# Local database files created by development tools (not site source)
*.sqlite
*.sqlite3
*.db
